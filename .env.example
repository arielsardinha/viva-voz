# ==============================================================================
# VIVAVOZ - VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env.local e preencha com as suas credenciais de desenvolvimento.
#
# NOTA DE SEGURANÇA:
# Nenhuma credencial do Google Drive ou segredo OAuth deve conter o prefixo NEXT_PUBLIC_.
# Todas as credenciais de autenticação residem estritamente no servidor (BFF).
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Drive Sync via BFF (Backend For Frontend)
# Escopo utilizado: https://www.googleapis.com/auth/drive.appdata
# ------------------------------------------------------------------------------
ENABLE_GOOGLE_DRIVE_SYNC=true
GOOGLE_DRIVE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=seu-google-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ------------------------------------------------------------------------------
# Sentry (Monitoramento de Erros e Performance - Opcional para Dev Local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ------------------------------------------------------------------------------
# Clarity (Análise de Uso e Engajamento - Microsoft)
# ------------------------------------------------------------------------------
CLARITY_PROJECT_ID=
